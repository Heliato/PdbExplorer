<Window x:Class="PdbExplorer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        Title="PDB Explorer" Width="1500" Height="900" MinWidth="800" MinHeight="500"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="12"
        AllowDrop="True" Drop="OnFileDropped" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <DockPanel>
        <!-- Titles and actions are attached in code (MainWindow.Menu.cs): the language can change at run time -->
        <Menu DockPanel.Dock="Top">
            <MenuItem x:Name="MFile">
                <MenuItem x:Name="MOpen" InputGestureText="Ctrl+O"/>
                <MenuItem x:Name="MInfo"/>
                <Separator/>
                <MenuItem x:Name="MExport" InputGestureText="Ctrl+S"/>
                <MenuItem x:Name="MExportClass" InputGestureText="Ctrl+Shift+E"/>
                <MenuItem x:Name="MExportList"/>
                <MenuItem x:Name="MExportAll" InputGestureText="Ctrl+Shift+S"/>
                <MenuItem x:Name="MCancel" InputGestureText="Esc" IsEnabled="False"/>
                <Separator/>
                <MenuItem x:Name="MExit" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem x:Name="MNav">
                <MenuItem x:Name="MFind" InputGestureText="Ctrl+T"/>
                <MenuItem x:Name="MFindDoc" InputGestureText="Ctrl+F"/>
                <MenuItem x:Name="MGoDef" InputGestureText="F12"/>
                <Separator/>
                <MenuItem x:Name="MBack" InputGestureText="Ctrl+-"/>
                <MenuItem x:Name="MForward" InputGestureText="Ctrl+Shift+-"/>
            </MenuItem>
            <MenuItem x:Name="MWindow">
                <MenuItem x:Name="MClose" InputGestureText="Ctrl+F4"/>
                <MenuItem x:Name="MCloseAll"/>
                <Separator/>
                <MenuItem x:Name="MNext" InputGestureText="Ctrl+Tab"/>
                <MenuItem x:Name="MPrev" InputGestureText="Ctrl+Shift+Tab"/>
            </MenuItem>
            <MenuItem x:Name="MTools">
                <MenuItem x:Name="MOptions"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Accent}" Height="23">
            <DockPanel Margin="8,0">
                <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="200" Height="4" Maximum="1" Visibility="Collapsed"
                             Background="#40FFFFFF" Foreground="White" BorderThickness="0"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="White" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <ad:DockingManager x:Name="Dock">
            <ad:LayoutRoot>
                <ad:LayoutPanel Orientation="Horizontal">
                    <ad:LayoutAnchorablePane DockWidth="400">
                        <ad:LayoutAnchorable x:Name="ExplorerPane" ContentId="explorer" CanClose="False" CanHide="False">
                            <DockPanel Background="{DynamicResource Panel}">
                                <ListBox x:Name="Categories" DockPanel.Dock="Top" SelectionChanged="OnCategorySelected">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{DynamicResource Dim}"/>
                                                <TextBlock Text="{Binding Glyph}" Foreground="{Binding Brush}" Width="20" FontFamily="Consolas" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Title}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,1" Padding="6">
                                    <Grid>
                                        <TextBox x:Name="SearchBox" TextChanged="OnSearchTextChanged" Padding="4,3"/>
                                        <TextBlock x:Name="SearchHint" IsHitTestVisible="False" Foreground="{DynamicResource Dim}" Margin="8,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Margin="8,4" Foreground="{DynamicResource Dim}"/>
                                <ListBox x:Name="Results" SelectionChanged="OnRowSelected" MouseDoubleClick="OnRowDoubleClicked" KeyDown="OnRowKeyDown"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel ToolTip="{Binding Name}">
                                                <TextBlock Text="{Binding Glyph}" Foreground="{Binding Brush}" Width="20" FontFamily="Consolas" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </ad:LayoutAnchorable>
                    </ad:LayoutAnchorablePane>

                    <ad:LayoutPanel Orientation="Vertical">
                        <ad:LayoutDocumentPane/>
                        <ad:LayoutAnchorablePane DockHeight="150">
                            <ad:LayoutAnchorable x:Name="OutputPane" ContentId="output" CanClose="False" CanHide="False">
                                <TextBox x:Name="OutputLog" IsReadOnly="True" BorderThickness="0" Background="{DynamicResource Editor}"
                                         FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>
                    </ad:LayoutPanel>

                    <ad:LayoutAnchorablePane DockWidth="360">
                        <ad:LayoutAnchorable x:Name="PropsPane" ContentId="props" CanClose="False" CanHide="False">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource Panel}">
                                <ItemsControl x:Name="PropertyList" Margin="4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Key, Mode=OneWay}" Foreground="{DynamicResource Dim}" Margin="4,2" TextWrapping="Wrap"/>
                                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                         BorderThickness="0" Background="Transparent"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </ad:LayoutAnchorable>
                    </ad:LayoutAnchorablePane>
                </ad:LayoutPanel>
            </ad:LayoutRoot>
        </ad:DockingManager>
    </DockPanel>
</Window>
